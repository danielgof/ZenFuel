{
  "manifest_version": 3,
  "name": "Zen Fuel",
  "description": "Provides information about MPG per vehicle based on data from https://www.fueleconomy.gov/",
  "version": "1.0",
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/favicon.png",
    "192": "icons/favicon-192.png",
    "512": "icons/favicon-512.png"
  },
  "permissions": ["activeTab", "scripting"]
}
