{
    "name": "ZenFuel",
    "description": "ZenFuel Extension",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "index.html",
        "default_icon": "zenfuel.png"
    },
    "icons": {
        "16": "zenfuel.png",
        "48": "zenfuel.png",
        "128": "zenfuel.png"
    },
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
